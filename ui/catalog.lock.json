    {
      "name": "command_run",
      "description": "Run an engine command by id with JSON params (see command_list). Returns the command's JSON result. Long commands (filters, Content-Aware Fill/Scale, Photomerge, brush import) wait to finish unless `wait` is false: then they run as a background job and the result is {job: id} (see jobs_list, jobs_cancel).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Command id, e.g. `layer.new.layer`, `filter.blur.gaussianBlur`."
          },
          "params": {
            "default": null,
            "description": "Command parameters as a JSON object (see the `params` doc in `command_list`)."
          },
          "wait": {
            "default": null,
            "description": "Wait for a long command (filters, Content-Aware Fill, Photomerge, …) to finish (default\ntrue). With false it runs as a background job and the result is `{\"job\": id}`: poll it\nwith `jobs_list`, stop it with `jobs_cancel`.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "title": "RunParams"
