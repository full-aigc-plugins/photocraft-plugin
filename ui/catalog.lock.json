{
  "tools": [
    {
      "name": "open_editor",
      "description": "Open PhotoCraft's interactive editor. Optionally load a file inside the current workspace. This opens the UI; it does not automate editing commands.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Workspace-relative file path",
            "type": "string",
            "maxLength": 4096
          },
          "workspace": {
            "type": "string",
            "description": "Absolute workspace path; set before opening an editor session."
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      },
      "_meta": {
        "ui": {
          "resourceUri": "ui://photocraft/panel.html",
          "surface": "editor",
          "visibility": [
            "model",
            "app"
          ]
        },
        "openai/ui": {
          "preferredModelDisplayMode": "fullscreen"
        }
      }
    },
    {
      "name": "session_list",
