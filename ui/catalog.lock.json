    {
      "name": "doc_place",
      "description": "Place a file into the document as a Smart Object layer (Place Embedded), reading `path` beneath the read root. `scale` (percent), `fit` and `center` are the command's own.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "center": {
            "default": null,
            "description": "Centre of the placed layer, in document pixels.",
            "anyOf": [
              {
                "minItems": 2,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "fit": {
            "default": null,
            "description": "Place at a centred size instead of a scaled one.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "index": {
            "default": null,
            "description": "Document index from `session_list` (default: the active document).",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": "string",
            "description": "Path beneath the configured automation read root: relative (forward slashes) or absolute."
          },
          "scale": {
            "default": null,
            "description": "Scale as a percentage; defaults to fitting a file larger than the canvas.",
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "path"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
        "additionalProperties": false,
        "title": "PlaceParams"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "openWorldHint": false
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    },
    {
      "name": "doc_export_layers",
      "description": "Export each exported layer of the document as its own file beneath the write root (the capability-scoped Layers to Files). A file that already exists is an error, not an overwrite.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dir": {
            "type": "string",
            "description": "Directory beneath the configured automation write root: relative (forward slashes) or absolute."
          },
          "format": {
            "default": null,
            "description": "Export format (default png).",
            "type": [
              "string",
              "null"
            ]
          },
          "index": {
            "default": null,
            "description": "Document index from `session_list` (default: the active document).",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "prefix": {
            "default": null,
            "description": "Filename prefix (default: the document name).",
            "type": [
              "string",
              "null"
            ]
          },
          "quality": {
            "default": null,
            "description": "Encoder quality, 0..12, for the formats that take one.",
            "type": [
              "number",
              "null"
            ]
          },
          "visible_only": {
            "default": null,
            "description": "Export only the layers that are visible (default true).",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "dir"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#",
