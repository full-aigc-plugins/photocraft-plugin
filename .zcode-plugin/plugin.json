{
  "name": "photocraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "图层、蒙版、抠图、修复与滤镜，支持文字与尺寸适配；工程可继续编辑，可导出 PSD、PNG 等格式。",
  "author": {
    "name": "Full AIGC Plugins",
    "url": "https://github.com/full-aigc-plugins"
  },
  "homepage": "https://github.com/full-aigc-plugins/photocraft-plugin",
  "repository": "https://github.com/full-aigc-plugins/photocraft-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "agent-plugin",
    "photocraft",
    "creative-workflow",
    "development-release"
  ],
  "skills": "./skills/",
  "displayName": "PhotoCraft（图片编辑）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "photocraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "PhotoCraft（图片编辑）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "PhotoCraft (Image Editing)",
          "zh-CN": "PhotoCraft（图片编辑）"
        },
        "icon": "image",
        "server": "photocraft-editor",
        "resourceUri": "ui://photocraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
